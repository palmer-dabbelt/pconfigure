# The half of pconfigure that a build can run on its own, one source
# at a time.  It is a BINARY rather than a LIBEXEC because pconfigure
# names its own tools by the directory it is running out of, and that
# is this one.
BINARIES    += pdeps
AUTODEPS     = false
DEPLIBS     += pinclude++
DEPLIBS     += pconfigure
DEPLIBS     += makefile
SOURCES     += pdeps.c++

# And the same for a vendored tree, which answers the same question by
# writing the answer down itself: this reads what the tree said rather
# than working anything out.  A BINARY for the same reason as above.
BINARIES    += psubdeps
AUTODEPS     = false
DEPLIBS     += pconfigure
DEPLIBS     += makefile
SOURCES     += psubdeps.c++

# These command-line tools are only ever run by the tests below, so
# they're built but never installed.
TESTEXECS   += pconfigure/string_utils-clean_white
COMPILEOPTS += -DTEST_CLEAN_WHITE
SOURCES     += libpconfigure/string_utils.c++
TESTSRC     += no_spaces.bash
TESTSRC     += internal_space.bash
TESTSRC     += internal_spaces.bash
TESTSRC     += leading_spaces.bash
TESTSRC     += trailing_spaces.bash
TESTSRC     += tab.bash

TESTEXECS   += pconfigure/string_utils-strip_char
COMPILEOPTS += -DTEST_STRIP_CHAR
SOURCES     += libpconfigure/string_utils.c++
TESTSRC     += three_parts.bash

TESTEXECS   += pconfigure/implied_deps-included
COMPILEOPTS += -DTEST_INCLUDED
DEPLIBS     += makefile
SOURCES     += libmakefile/implied_deps.c++
TESTSRC     += fragment.bash

TESTEXECS   += pconfigure/vector_util-map
COMPILEOPTS += -DTEST_MAP
SOURCES     += libpconfigure/vector_util.c++
TESTSRC     += builtin.bash

